# Core Next.js Deployment Configs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Infrastructure (Replace with your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe Configuration (Future Scope for Premium Listings/Verifications)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google Maps Platform (Places Autocomplete for the buyer address field).
# Leave blank to fall back to the free, keyless OpenStreetMap autocomplete.
# Get a key at https://console.cloud.google.com/google/maps-apis — enable
# "Places API", create an API key, and restrict it to your domain(s) plus
# localhost for local development.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Scope addendum feature flags (NDA listings, usernames, bulk wine).
# Set to "true" to enable in a given environment; unset/false = disabled.
# See docs/scope-addendum-decisions.md, Decision 4.
NEXT_PUBLIC_FEATURE_USERNAMES=false
NEXT_PUBLIC_FEATURE_NDA_LISTINGS=false
NEXT_PUBLIC_FEATURE_BULK_WINE=false
