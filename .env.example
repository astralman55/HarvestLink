# Core Next.js Deployment Configs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Infrastructure (Replace with your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe Configuration (Future Scope for Premium Listings/Verifications)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Scope addendum feature flags (NDA listings, usernames, bulk wine).
# Set to "true" to enable in a given environment; unset/false = disabled.
# See docs/scope-addendum-decisions.md, Decision 4.
NEXT_PUBLIC_FEATURE_USERNAMES=false
NEXT_PUBLIC_FEATURE_NDA_LISTINGS=false
NEXT_PUBLIC_FEATURE_BULK_WINE=false

# Resend (inquiry "you have a new message" notification emails). Leave
# blank to run with email notifications silently disabled -- every other
# feature works the same either way. Get a key at https://resend.com/api-keys.
RESEND_API_KEY=
# Optional: defaults to Resend's own sandbox sender, which only delivers to
# the email on your Resend account. Once you verify a sending domain in
# Resend, point this at an address on it to notify real users.
RESEND_FROM_EMAIL=

# Shown as the contact address on the Terms of Service and Privacy Policy
# pages. Leave blank and the contact section is simply left out.
NEXT_PUBLIC_CONTACT_EMAIL=

# Length of the emailed confirmation code. Must match Supabase Dashboard ->
# Authentication -> Providers -> Email -> "Email OTP Length" (6 is typical;
# this project currently uses 8). Only affects auto-submit on /verify-email.
NEXT_PUBLIC_OTP_LENGTH=6

# Secret that lets Vercel Cron call /api/cron/saved-searches (daily email alerts). Any long random string.
CRON_SECRET=
